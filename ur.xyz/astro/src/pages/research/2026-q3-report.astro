---
// /research/2026-q3-report — the August–October 2026 research report.
//
// The page body is the React component the SPA renders for this route
// (react/src/components/pages/ResearchReport.jsx), rendered to static HTML:
// the timeline, the start-to-end estimates, the methods and the glossary need
// no script (an entry's second layer is a native <details>). The parts that
// follow the reader are islands, passed in through the component's props of
// the same names: the sections sidebar, the meters in the rail (wide screens),
// the bar that docks under the nav with its menu of sections (narrow screens),
// the glance chart (drawn at its measured width), the seven method animations
// and the glossary tooltips. Their server render is their first state (before
// the first entry, each animation on its key frame), so the page reads the
// same before they hydrate. The meters that close the timeline on narrow
// screens never move (where each ended); they hydrate for their tooltips and
// toggles. English-only, like /mainnet and the investor documents.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import FooterStatic from '../../components/FooterStatic.astro';
import ResearchReportPage, { REPORT, REPORT_PATH } from '@react/components/pages/ResearchReport.jsx';
import ReportMeters from '@react/components/pages/research-report/Meters.jsx';
import ReportDock from '@react/components/pages/research-report/Dock.jsx';
import ReportGlance from '@react/components/pages/research-report/Glance.jsx';
import MethodFigure from '@react/components/pages/research-report/MethodFigure.jsx';
import TermTips from '@react/components/pages/research-report/TermTips.jsx';
import ReportToc from '@react/components/pages/research-report/Toc.jsx';
import en from '@react/i18n/en.js';
import { LASTMOD_TOKEN } from '../../lib/lastmod.js';

import '@react/components/Nav.css';

const title = `${REPORT.title} | UR`;
const description = 'Why UR’s network research matters, its gigabit-class milestone, and 39 measured changes from August 24 to October 24, 2026, with how far each kind of gain went.';
const canonical = `https://ur.xyz${REPORT_PATH}`;
const m = REPORT.methods;
// the report as what it is: a dated report by the Foundation
const jsonLd = [{
    '@type': 'Report',
    '@id': `${canonical}#report`,
    headline: REPORT.title,
    description,
    datePublished: REPORT.published,
    temporalCoverage: `${REPORT.period.start}/${REPORT.period.end}`,
    author: { '@id': 'https://ur.xyz/#org' },
    publisher: { '@id': 'https://ur.xyz/#org' },
    mainEntityOfPage: canonical,
    url: canonical,
    isBasedOn: REPORT.source.href,
}];
---
<Base
    title={title}
    description={description}
    breadcrumbName={REPORT.title}
    lang="en"
    ogType="article"
    article={{ publishedTime: REPORT.published, author: 'UR Foundation' }}
    jsonLd={jsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="research" lang="en" client:idle={{ timeout: 1000 }} />

        <main class="section-page">
            {/* "Updated" states the sitemap's lastmod: the build fills the
                token in once the page is fingerprinted (src/lib/lastmod.js) */}
            <ResearchReportPage updated={LASTMOD_TOKEN}>
                <ReportToc slot="toc" client:idle />
                <ReportGlance slot="glance" client:visible={{ rootMargin: '200px' }} />
                <ReportMeters slot="finalMeters" mode="final" client:visible={{ rootMargin: '200px' }} />
                <ReportMeters slot="railMeters" mode="rail" client:idle />
                <ReportDock slot="dock" client:idle />
                <TermTips slot="termTips" client:idle />
                <MethodFigure slot="figureOwners" sceneKey={m[0].key} label={m[0].alt} caption={m[0].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureBoundary" sceneKey={m[1].key} label={m[1].alt} caption={m[1].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureDeterministic" sceneKey={m[2].key} label={m[2].alt} caption={m[2].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureAblation" sceneKey={m[3].key} label={m[3].alt} caption={m[3].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureLayers" sceneKey={m[4].key} label={m[4].alt} caption={m[4].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureNoise" sceneKey={m[5].key} label={m[5].alt} caption={m[5].caption} client:visible={{ rootMargin: '200px' }} />
                <MethodFigure slot="figureValidity" sceneKey={m[6].key} label={m[6].alt} caption={m[6].caption} client:visible={{ rootMargin: '200px' }} />
            </ResearchReportPage>
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
