---
// /research/methodology — how UR's research works: three nested research
// loops (the lab, the open competition, the volunteer field nodes) and the
// discipline they share. Linked from the methodology's card on /research in
// every language; English-only, like the research reports.
//
// The page body is the React component the SPA renders for this route
// (react/src/components/pages/ResearchMethodology.jsx), rendered to static
// HTML. It needs no island: the three loops' rings turn in CSS
// (ResearchLoops.css) and stand still under reduced motion.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import FooterStatic from '../../components/FooterStatic.astro';
import ResearchMethodologyPage, { METHODOLOGY_PATH } from '@react/components/pages/ResearchMethodology.jsx';
import { METHODOLOGY } from '@react/data/research-methodology.js';
import en from '@react/i18n/en.js';

import '@react/components/Nav.css';

const title = `${METHODOLOGY.title} | UR`;
const description = METHODOLOGY.description;
const canonical = `https://ur.xyz${METHODOLOGY_PATH}`;
const jsonLd = [{
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: METHODOLOGY.title,
    description,
    datePublished: METHODOLOGY.published,
    author: { '@id': 'https://ur.xyz/#org' },
    publisher: { '@id': 'https://ur.xyz/#org' },
    mainEntityOfPage: canonical,
    url: canonical,
}];
---
<Base
    title={title}
    description={description}
    breadcrumbName={METHODOLOGY.title}
    lang="en"
    ogType="article"
    article={{ publishedTime: METHODOLOGY.published, author: 'UR Foundation' }}
    jsonLd={jsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="research" lang="en" client:idle={{ timeout: 1000 }} />

        <main class="section-page">
            <ResearchMethodologyPage />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
